# Copy to .env in this directory (gitignored) and fill in.

# FatSecret OAuth 2.0 credentials — the same pair that is set in the Railway
# service's environment variables today.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Shared secret the Vercel app must send as the X-Proxy-Secret header.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The proxy refuses all requests if this is empty.
FATSECRET_PROXY_SECRET=

# Port for the local listener (Cloudflare tunnel points here). Default 8787.
PORT=8787

# Only needed for the push-token design (push_token.py), not the proxy.
# Same value as POSTGRES_URL in the Vercel project.
POSTGRES_URL=
